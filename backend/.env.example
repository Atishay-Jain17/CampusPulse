# Backend environment variables
# Copy to .env for local development (NEVER commit .env)

# DynamoDB table name (auto-set by SAM during deployment)
TABLE_NAME=campuspulse-issues-local

# AWS region (auto-set by Lambda runtime in production)
AWS_REGION=us-east-1

# Administrator token for status update operations
# Generate with: openssl rand -hex 32
# Set securely in SAM deploy: --parameter-overrides AdminToken=<your-token>
ADMIN_TOKEN=REPLACE_WITH_SECURE_TOKEN_NEVER_COMMIT_REAL_VALUE
